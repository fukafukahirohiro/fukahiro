def gettime():
    now = datetime.datetime.now()
    return now.strftime("%H:%M")

def update_time(label1):
    nowtime = gettime()
    label1.config(text=nowtime)
    label1.after(1000, update_time, label1)  # 1000ms (1秒) ごとに更新

